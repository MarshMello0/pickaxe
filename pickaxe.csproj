<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- TwoDogWebBoot.cs (web hosts) takes a function pointer to the source-generated plugins initializer;
             harmless on desktop -->
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Keep nested host projects out of the default compile/content globs (their .gdignore hides them
             from the Godot editor) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);pickaxe.web/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <!-- Web bootstrap lives in the web host folder but must compile into THIS assembly: scripts resolve
             from the assembly holding the source-generated plugins initializer. Inert without a web host -->
        <Compile Include="pickaxe.web/TwoDogWebBoot.cs"
                 Condition="Exists('$(MSBuildThisFileDirectory)pickaxe.web/TwoDogWebBoot.cs')"/>
        <!-- The webxr host carries its own copy; compile it only when the plain
             web host's is absent (one definition per assembly). -->
        <Compile Include="pickaxe.webxr/TwoDogWebBoot.cs"
                 Condition="!Exists('$(MSBuildThisFileDirectory)pickaxe.web/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)pickaxe.webxr/TwoDogWebBoot.cs')"/>
        <!-- Same for the blazor host, last in line. -->
        <Compile Include="pickaxe.blazor/TwoDogWebBoot.cs"
                 Condition="!Exists('$(MSBuildThisFileDirectory)pickaxe.web/TwoDogWebBoot.cs') And !Exists('$(MSBuildThisFileDirectory)pickaxe.webxr/TwoDogWebBoot.cs') And Exists('$(MSBuildThisFileDirectory)pickaxe.blazor/TwoDogWebBoot.cs')"/>
    </ItemGroup>
</Project>
